# STM32F3xx high density device (F302xD/E, F303xD/E, F398xE)

name             STM32F302_F303_F398_HD
reference        RM0365      # also RM0316 (Rev 5)
chip_id          0x446       # STM32_CHIPID_F303_HD
family           F0_F1_F3

flash.base       0x08000000
flash.size_reg   0x1ffff7cc
flash.page_size  0x800       # 2 KB

sram.base        0x20000000
sram.size        0x10000     # 64 KB

bootrom.base     0x1fffd800
bootrom.size     0x2000      # 8 KB

option.base      0x1ffff800  # STM32_OPTION_BYTES_BASE_F0
option.size      0x10        # 16 B

flags            swo
