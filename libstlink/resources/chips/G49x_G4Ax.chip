# STM32G49x / STM32G4Ax

name             STM32G49x_G4Ax
reference        RM0440
chip_id          0x479       # STM32_CHIPID_G4_CAT4
family           G4

flash.base       0x08000000
flash.size_reg   0x1fff75e0
flash.page_size  0x800       # 2 KB

sram.base        0x20000000
sram.size        0x1c000     # 112 KB

bootrom.base     0x1fff0000
bootrom.size     0x7000      # 28 KB

option.base      0x1ffff800  # STM32_OPTION_BYTES_BASE_G4
option.size      0x4         # 4 B

flags            swo dualbank
