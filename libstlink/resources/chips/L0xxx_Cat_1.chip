# STM32L0xxx (Cat.1) device (L010x3 / L010x4 / L011x / L021x)

name             STM32L0xxx_Cat_1
reference        RM0451      # also RM0377
chip_id          0x457       # STM32_CHIPID_L0_CAT1
family           L0_L1

flash.base       0x08000000
flash.size_reg   0x1ff8007c
flash.page_size  0x80        # 128 B

sram.base        0x20000000
sram.size        0x2000      # 8 KB

bootrom.base     0x1ff00000
bootrom.size     0x2000      # 8 KB

option.base      0x1ff80000  # STM32_OPTION_BYTES_BASE_L0
option.size      0x20        # 32 B
