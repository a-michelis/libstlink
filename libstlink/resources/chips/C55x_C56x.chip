# STM32C55x / STM32C56x

name             STM32C55x_C56x
reference        RM0522
chip_id          0x44e    # STM32_CHIPID_C55x_C56x
family           C5

flash.base       0x08000000
flash.size_reg   0x08fff80c
flash.page_size  0x2000   # 8 KB

sram.base        0x20000000
sram.size        0x20000  # 128 KB

bootrom.base     0x0bf80080
bootrom.size     0x8400   # 33 KB

option.base      0
option.size      0

flags            swo dualbank
