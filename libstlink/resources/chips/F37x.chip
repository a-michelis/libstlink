# STM32F37x

name             STM32F37x
reference        RM0313
chip_id          0x432       # STM32_CHIPID_F37x
family           F0_F1_F3

flash.base       0x08000000
flash.size_reg   0x1ffff7cc
flash.page_size  0x800       # 2 KB

sram.base        0x20000000
sram.size        0xa000      # 40 KB

bootrom.base     0x1ffff000
bootrom.size     0x800       # 2 KB

option.base      0x1ffff800  # STM32_OPTION_BYTES_BASE_F0
option.size      0x10        # 16 B

flags            swo
