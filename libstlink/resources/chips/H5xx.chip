# STM32H5xx

name             STM32H5xx
reference        RM0481
chip_id          0x484    # STM32_CHIPID_H5xx
family           H5

flash.base       0x08000000
flash.size_reg   0x08fff80c
flash.page_size  0x2000   # 8 KB

sram.base        0x20000000
sram.size        0xa0000  # 640 KB

bootrom.base     0x0bf80000
bootrom.size     0x8000   # 32 KB

option.base      0x0
option.size      0x0

flags            dualbank
