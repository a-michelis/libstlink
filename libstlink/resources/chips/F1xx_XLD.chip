# STM32F1xx XL density

name             STM32F1xx_XLD
reference        RM0008
chip_id          0x430       # STM32_CHIPID_F1_XLD
family           F1_XL

flash.base       0x08000000
flash.size_reg   0x1ffff7e0
flash.page_size  0x800       # 2 KB

sram.base        0x20000000
sram.size        0x18000     # 96 KB

bootrom.base     0x1fffe000
bootrom.size     0x1800      # 6 KB

option.base      0x1ffff800  # STM32_OPTION_BYTES_BASE_F0
option.size      0x10        # 16 B

flags            swo
