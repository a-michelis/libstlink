# STM32F2xx

name             STM32F2xx
reference        RM0033
chip_id          0x411       # STM32_CHIPID_F2
family           F2_F4

flash.base       0x08000000
flash.size_reg   0x1fff7a22
flash.page_size  0x20000     # 128 KB

sram.base        0x20000000
sram.size        0x20000     # 128 KB

bootrom.base     0x1fff0000
bootrom.size     0x7800      # 30 KB

option.base      0x1fffc000  # STM32_OPTION_BYTES_BASE_F2
option.size      0x4         # 4 B

flags            swo
