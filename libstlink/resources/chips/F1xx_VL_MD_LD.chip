# STMF1xx Value Line medium & low density

name             STM32F1xx_VL_MD_LD
reference        RM0041
chip_id          0x420       # STM32_CHIPID_F1_VL_MD_LD
family           F0_F1_F3

flash.base       0x08000000
flash.size_reg   0x1ffff7e0
flash.page_size  0x400       # 1 KB

sram.base        0x20000000
sram.size        0x2000      # 8 KB /* 0x1000 for low density devices */

bootrom.base     0x1ffff000
bootrom.size     0x800       # 2 KB

option.base      0x1ffff800  # STM32_OPTION_BYTES_BASE_F0
option.size      0x10        # 16 B

flags            swo
