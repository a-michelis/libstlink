# STM32H72x / STM32H73x

name             STM32H72x_H73x
reference        RM0468
chip_id          0x483       # STM32_CHIPID_H72x
family           H7

flash.base       0x08000000
flash.size_reg   0x1ff1e880
flash.page_size  0x20000     # 128 KB

sram.base        0x20000000
sram.size        0x20000     # 128 KB "DTCM"

bootrom.base     0x1ff00000
bootrom.size     0x20000     # 128 KB

option.base      0x52002020  # STM32_OPTION_BYTES_BASE_H7
option.size      0x2c        # 44 B

flags            swo
