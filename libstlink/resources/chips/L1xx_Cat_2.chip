# STM32L1xx (Cat.2) device (L100C6-A / L100R8-A / L100RB-A)

name             STM32L1xx_Cat_2
reference        RM0038
chip_id          0x429   # STM32_CHIPID_L1_CAT2
family           L0_L1

flash.base       0x08000000
flash.size_reg   0x1ff8004c
flash.page_size  0x100   # 128 B

sram.base        0x20000000
sram.size        0x8000  # 32 KB

bootrom.base     0x1ff00000
bootrom.size     0x1000  # 4 KB

option.base      0x0
option.size      0x0

flags            swo
