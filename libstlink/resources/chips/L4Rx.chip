# STM32L4Rx

name             STM32L4Rx
reference        RM0432
chip_id          0x470    # STM32_CHIPID_L4RX
family           L4

flash.base       0x08000000
flash.size_reg   0x1fff75e0
flash.page_size  0x1000   # 4 KB

sram.base        0x20000000
sram.size        0xa0000  # 640 KB

bootrom.base     0x1fff0000
bootrom.size     0x7000   # 28 KB

option.base      0x1ff00000
option.size      0x4      # 4 B

flags            swo
