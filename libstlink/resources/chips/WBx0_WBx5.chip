# STM32WBx0 / STM32WBx5

name             STM32WBx0_WBx5
reference        RM0434   # also RM0471
chip_id          0x495    # STM32_CHIPID_WB55
family           WB_WL

flash.base       0x08000000
flash.size_reg   0x1fff75e0
flash.page_size  0x1000   # 4 KB

sram.base        0x20000000
sram.size        0x40000  # 256 KB

bootrom.base     0x1fff0000
bootrom.size     0x7000   # 28 KB

option.base      0x1fff8000
option.size      0x80     # 128 B

flags            swo
