# STM32F04x

name             STM32F04x
reference        RM0091
chip_id          0x445       # STM32_CHIPID_F04
family           F0_F1_F3

flash.base       0x08000000
flash.size_reg   0x1ffff7cc
flash.page_size  0x400       # 1 KB

sram.base        0x20000000
sram.size        0x1800      # 6 KB

bootrom.base     0x1fffec00
bootrom.size     0xc00       # 3 KB

option.base      0x1ffff800  # STM32_OPTION_BYTES_BASE_F0
option.size      0x10        # 16 B
