# STM32F1xx Connectivity Line device (F105 / F107)

name             STM32F1xx_CL
reference        RM0008
chip_id          0x418       # STM32_CHIPID_F1_CONN
family           F0_F1_F3

flash.base       0x08000000
flash.size_reg   0x1ffff7e0
flash.page_size  0x800       # 2 KB

sram.base        0x20000000
sram.size        0x10000     # 64 KB

bootrom.base     0x1fffb000
bootrom.size     0x4800      # 18 KB

option.base      0x1ffff800  # STM32_OPTION_BYTES_BASE_F0
option.size      0x10        # 16 B

flags            swo
