# STM32WB06 / STM32WB07 (formerly BlueNRG-LP)

name             STM32WB06_WB07
reference        RM0530   # also RM0479
chip_id          0x01e    # STM32_CHIPID_WB06_WB07
family           WB0

flash.base       0x08000000
flash.size_reg   0x40001014
flash.page_size  0x800    # 2 KB

sram.base        0x20000000
sram.size        0x10000  # 64 KB

bootrom.base     0x0
bootrom.size     0x4000   # 16 KB

option.base      0x0      # protection via FLASH controller commands
option.size      0x0

otp.base         0x10001800
otp.size         0x400    # 1 KB
