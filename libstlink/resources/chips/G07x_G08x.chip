# STM32G07x / STM32G08x

name             STM32G07x_G08x
reference        RM0444      # also RM454
chip_id          0x460       # STM32_CHIPID_G0_CAT2
family           G0

flash.base       0x08000000
flash.size_reg   0x1fff75e0
flash.page_size  0x800       # 2 KB

sram.base        0x20000000
sram.size        0x9000      # 36 KB

bootrom.base     0x1fff0000
bootrom.size     0x7000      # 28 KB

option.base      0x1fff7800  # STM32_OPTION_BYTES_BASE_G0
option.size      0x80        # 128 B
