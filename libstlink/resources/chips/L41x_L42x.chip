# STM32L41x / STM32L42x

name             STM32L41x_L42x
reference        RM0394
chip_id          0x464       # STM32_CHIPID_L41x_L42x
family           L4

flash.base       0x08000000
flash.size_reg   0x1fff75e0
flash.page_size  0x800       # 2 KB

sram.base        0x20000000
sram.size        0xa000      # 40 KB

bootrom.base     0x1fff0000
bootrom.size     0x7000      # 28 KB

option.base      0x1fff7800  # STM32_OPTION_BYTES_BASE_L4
option.size      0x4         # 4 B

flags            swo
