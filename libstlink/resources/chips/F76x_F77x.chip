# STM32F76x / STM32F77x

name             STM32F76x_F77x
reference        RM0410
chip_id          0x451       # STM32_CHIPID_F76xxx
family           F7

flash.base       0x08000000
flash.size_reg   0x1ff0f442
flash.page_size  0x800       # 2 KB

sram.base        0x20000000
sram.size        0x80000     # 512 KB

bootrom.base     0x200000
bootrom.size     0xedc0      # 59.4375 KB

option.base      0x1fff0000  # STM32_OPTION_BYTES_BASE_F7 /* Used for reading back option bytes, writing uses STM32_FLASH_F7_OPTCR and STM32_FLASH_F7_OPTCR1 */
option.size      0x20        # 32 B

flags            swo dualbank
