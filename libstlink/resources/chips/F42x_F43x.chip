# STM32F42x / STM32F43x

name             STM32F42x_F43x
reference        RM0090   # RM0090 (Rev. 2)
chip_id          0x419    # STM32_CHIPID_F4_HD
family           F2_F4

flash.base       0x08000000
flash.size_reg   0x1fff7a22
flash.page_size  0x4000   # 16 KB

sram.base        0x20000000
sram.size        0x40000  # 256 KB

bootrom.base     0x1fff0000
bootrom.size     0x7800   # 30 KB

option.base      0x0
option.size      0x0

flags            swo
