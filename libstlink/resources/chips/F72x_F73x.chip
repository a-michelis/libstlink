# STM32F72x / STM32F73x

name             STM32F72x_F73x
reference        RM0431
chip_id          0x452       # STM32_CHIPID_F72xxx
family           F7

flash.base       0x08000000
flash.size_reg   0x1ff07a22
flash.page_size  0x800       # 2 KB

sram.base        0x20000000
sram.size        0x40000     # 256 KB

bootrom.base     0x100000
bootrom.size     0xedc0      # 59.4375 KB

option.base      0x1fff0000  # STM32_OPTION_BYTES_BASE_F7
option.size      0x20        # 32 B

flags            swo
