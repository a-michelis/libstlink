# STM32L1xx (Cat.4) device (L15xxD / L162xD)

name             STM32L1xx_Cat_4
reference        RM0038
chip_id          0x436       # STM32_CHIPID_L1_MD_PLUS_HD
family           L0_L1

flash.base       0x08000000
flash.size_reg   0x1ff800cc
flash.page_size  0x100       # 128 B

sram.base        0x20000000
sram.size        0xc000      # 48 KB

bootrom.base     0x1ff00000
bootrom.size     0x1000      # 4 KB

option.base      0x1ff80000  # STM32_OPTION_BYTES_BASE_L1
option.size      0x8         # 8 B

flags            swo
