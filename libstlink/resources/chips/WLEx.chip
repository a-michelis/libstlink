# STM32WLEx

name             STM32WLEx
reference        RM0033
chip_id          0x497    # STM32_CHIPID_WLE
family           WB_WL

flash.base       0x08000000
flash.size_reg   0x1fff75e0
flash.page_size  0x800    # 2 KB

sram.base        0x20000000
sram.size        0x10000  # 64 KB

bootrom.base     0x1fff0000
bootrom.size     0x7000   # 28 KB

option.base      0x1fff7800
option.size      0x10     # 16 B

flags            swo dualbank
